# Supabase Configuration
# Replace these values with your project's credentials from the Supabase Dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Google Gemini API Key for AI features (NLP task parser, Daily Digest)
GEMINI_API_KEY=your-gemini-api-key-here
